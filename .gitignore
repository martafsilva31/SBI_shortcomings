# ── Sub-repos (independent git repos — NOT tracked by container) ─────────
asimov-aymptotics-check/

# ── Generated outputs (belong inside sub-repos, not at container level) ──
output/
plots/
ntuples/
*.root

# ── Local dataset copy (CERNBox is the source of truth — never commit) ───
data/

# ── PDF / plot files ──────────────────────────────────────────────────────
*.pdf
*.png
*.eps

# ...except meeting decks, which are versioned alongside the code that made them
!docs/presentations/**/*.pdf

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── ATLAS ─────────────────────────────────────────────────────────────────
.asetup.save
build/

# ── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
*.swp
